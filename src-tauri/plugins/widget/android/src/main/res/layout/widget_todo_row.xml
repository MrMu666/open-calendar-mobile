<?xml version="1.0" encoding="utf-8"?>
<!-- 单条待办行：优先级圆点 + 标题
     行内刻意不放时间：空间全部让给标题（3x4 的格子里标题比时间有价值）。
     圆点颜色由 Kotlin 侧按优先级下发，与 P 徽标同色。
     RemoteViews 不支持 ConstraintLayout/TableLayout，故用 RelativeLayout 平铺。 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="3dp"
    android:background="@drawable/widget_row_bg"
    android:paddingStart="@dimen/widget_row_padding_h"
    android:paddingTop="@dimen/widget_row_padding_v"
    android:paddingEnd="@dimen/widget_row_padding_h"
    android:paddingBottom="@dimen/widget_row_padding_v">

    <TextView
        android:id="@+id/widget_item_priority"
        style="@style/Widget.Todo.Badge"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/widget_badge_bg"
        android:textColor="@color/widget_priority_p1" />

    <TextView
        android:id="@+id/widget_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="7dp"
        android:layout_toEndOf="@id/widget_item_priority"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_text_dark"
        android:textSize="12sp" />
</RelativeLayout>
