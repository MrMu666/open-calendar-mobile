<?xml version="1.0" encoding="utf-8"?>
<!-- 3×4 待办小组件：半透明卡片（Header + 事项列表容器 + Footer）
     RemoteViews 布局层级刻意压浅：只允许 FrameLayout / LinearLayout / RelativeLayout
     等白名单容器，事项行由 Kotlin 侧 addView 动态填充（widget_todo_row.xml）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_bg"
        android:orientation="vertical"
        android:padding="@dimen/widget_card_padding">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/widget_name"
                android:textColor="@color/widget_text_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_subtext_dark"
                android:textSize="10sp" />

            <!-- 右上角「新增事项」按钮：
                 用嵌套 RelativeLayout 是为了让加号靠右且垂直居中，
                 颜色/背景由 Kotlin 侧下发（本主题色，无需 setInt 反射调未标注方法） -->
            <RelativeLayout
                android:id="@+id/widget_add_wrap"
                android:layout_width="24dp"
                android:layout_height="24dp">

                <TextView
                    android:id="@+id/widget_add"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/widget_add_bg"
                    android:gravity="center"
                    android:text="@string/widget_add"
                    android:textColor="@color/widget_text_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_divider_dark" />

        <LinearLayout
            android:id="@+id/widget_items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/widget_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:paddingTop="3dp"
            android:singleLine="true"
            android:textColor="@color/widget_subtext_dark"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 空态 / 渲染报错文案：
         用 match_parent + gravity=center，而不是 wrap_content + layout_gravity=center
         —— 后者在 RemoteViews 里子文本没有宽度约束，会被压成 0 宽度，
         桌面看起来完全空白（连渲染错误原因都显示不出来）。已踩坑。 -->
    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone">

        <!-- 不用 ?android:attr/progressBarStyleSmall：库布局在桌面进程 inflate，
             主题属性可能取不到，直接给尺寸 + 自带 drawable 更稳 -->
        <ProgressBar
            android:id="@+id/widget_progress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/widget_progress"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:text="@string/widget_empty"
            android:textColor="@color/widget_subtext_dark"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
