<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- tauri android init 时自动合并进应用 manifest：
         AppWidgetProvider 由系统桌面进程加载，必须声明为 exported receiver。 -->
    <application>
        <receiver
            android:name="app.tauri.widget.TodoWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.tauri.widget.ACTION_OPEN_ITEM" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_todo_info" />
        </receiver>
    </application>
</manifest>
